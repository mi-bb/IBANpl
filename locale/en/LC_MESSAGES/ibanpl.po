#: iban.py:202
msgid "Informacje o bankach zostały pomyślnie uaktualnione."
msgstr "Bank information has been updated successfully."

#: iban.py:207
msgid "Nie udało się zaktualizować informacji o bankach:\n"
msgstr "Could not update the bank information:\n"

#: iban.py:219
msgid "Pytanie"
msgstr "Question"

#: iban.py:233
msgid "Informacja"
msgstr "Information"

#: ibanpl.py:68
#, python-brace-format
msgid "Powinno być 26 znaków, jest {0:d}"
msgstr "There should be 26 digits, got {0:d}"

#: ibanpl.py:80 ibanpl.py:193
msgid "Nieprawidłowy znak"
msgstr "Invalid character"

#: ibanpl.py:83
msgid "Numer prawidłowy"
msgstr "The number is correct"

#: ibanpl.py:85
msgid "Błąd w numerze"
msgstr "Error in the number"

#: ibanpl.py:268
msgid "Nie udało się połączyć z serwerem NBP w celu pobrania danych o bankach"
msgstr "Could not connect to the NBP server to download bank data"

#: ibanpl.py:277
msgid ""
"Czy uaktualnić bazę informacji o bankach danymi pobranymi ze strony NBP?"
msgstr ""
"Update the bank information database with data downloaded from the NBP "
"website?"

#: ibanpl.py:280
msgid ""
"Dzisiaj już aktualizowano dane. Czy wykonać aktualizację danymi pobranymi ze "
"strony NBP jeszcze raz?"
msgstr ""
"Data has already been updated today. Update again with data downloaded from "
"the NBP website?"

#: ibanpl.py:337 ibanpl.py:343
#, python-brace-format
msgid "Nieprawidłowy format pobranych danych o bankach (linia {0})"
msgstr "Invalid format of the downloaded bank data (line {0})"

#: ibanpl.py:350
#, python-brace-format
msgid ""
"Pobrane dane o bankach wyglądają na niekompletne (otrzymano {0} rekordów)"
msgstr ""
"The downloaded bank data appears to be incomplete ({0} records received)"

#: ibanpl.py:414
msgid "Nie udało się pobrać danych o bankach z serwera NBP"
msgstr "Could not download bank data from the NBP server"

#: ibanpl.py:419
#, python-brace-format
msgid "Błąd podczas przetwarzania pobranych danych: {0}"
msgstr "Error while processing the downloaded data: {0}"
