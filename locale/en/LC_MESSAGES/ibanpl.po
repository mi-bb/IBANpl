#: iban.py:39
msgid "Wybierz numery banku i jednostki organizacyjnej"
msgstr "Select the bank and organisational unit numbers"

#: iban.py:50
msgid "Uaktualnij bazę"
msgstr "Update Database"

#: iban.py:57
msgid "Lub wpisz numer konta:"
msgstr "Or enter an account number:"

#: iban.py:60
msgid ""
"Wpisz ręcznie numer konta, aby pokazać\n"
"informacje o banku i zweryfikować jego poprawność.\n"
"Aby działał wybór numerów z list, to pole musi być puste"
msgstr ""
"Enter an account number manually to show\n"
"information about the bank and verify its correctness.\n"
"To use the number selection from the lists, this field must be empty"

